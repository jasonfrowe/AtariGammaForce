  r = 0 : gosub b15chk bank15 : res[15] = r
  r = 0 : gosub b16chk bank16 : res[16] = r
  rem the switched banks, as the game switches them (pf_stage)
  asm
  lda #0
  sta $8000
  jsr b2asm
  sta res2+2
  lda #1
  sta $8000
  jsr b3asm
  sta res2+3

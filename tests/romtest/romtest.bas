  rem generated by romtest.py
  set romsize 272k
  displaymode 320A
  set zoneheight 8
  dim res = var0      ; via bank gosub, by bank
  dim res2 = var20    ; via a direct $8000 write, by bank
  dim pass = var40
  dim chk = var41
  BACKGRND = $00
  P0C2 = $0F
  P1C2 = $C8
  P2C2 = $36
  characterset atascii
  alphachars ASCII
  pass = 0

  rem bank 1 (always in at $4000) and the last bank (always at $C000)
  r = b1sig[0] : chk = b1sig[1] : if chk = b1sig_k then res[1] = r : res2[1] = r
  r = b17sig[0] : chk = b17sig[1] : if chk = b17sig_k then res[17] = r : res2[17] = r
  rem the switched banks, by 7800basic's bank gosub
  r = 0 : gosub b2chk bank2 : res[2] = r
  r = 0 : gosub b3chk bank3 : res[3] = r
  r = 0 : gosub b4chk bank4 : res[4] = r
  r = 0 : gosub b5chk bank5 : res[5] = r
